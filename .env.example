# Browser-visible backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg_async://postgres:postgres@localhost:55432/docqa
REDIS_URL=redis://localhost:56379/0
S3_ENDPOINT_URL=http://localhost:59000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_BUCKET=documents

# Optional real-model profile (defaults remain deterministic for CI/local setup)
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_SOURCE_REPO=qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
# EMBEDDING_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
# ANSWER_PROVIDER=ollama
# ANSWER_MODEL=qwen2.5:1.5b
# ANSWER_MAX_OUTPUT_TOKENS=384
# OLLAMA_BASE_URL=http://localhost:11434

# Authentication and quotas
# Local HTTP deliberately uses *_dev cookies. Staging/production requires true and HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_ABSOLUTE_HOURS=168
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=2
AUTH_LOGIN_ATTEMPT_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTRATION_ATTEMPT_LIMIT=5
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_MAX_ACTIVE_SESSIONS=5
QUOTA_DOCUMENTS_PER_USER=100
QUOTA_QUESTIONS_PER_DAY=200
QUOTA_CONCURRENT_GENERATIONS_PER_USER=1
